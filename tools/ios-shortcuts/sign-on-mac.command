#!/bin/zsh

# AI: below section was generated by an AI
# Standalone helper copied beside unsigned/ by generate.py. Uses Apple's supported
# signing command, never account credentials or a third-party signing service.
# Reference: https://support.apple.com/guide/shortcuts-mac/apd455c82f02/mac
set -eu

packageDir="${0:A:h}"
names=(
  "WLED Alarm Check"
  "WLED Alarm Setup"
  "WLED Alarm Sync"
  "WLED Alarm Status"
  "WLED Alarm Clear"
)

for name in "${names[@]}"; do
  sourceFile="$packageDir/unsigned/$name.shortcut"
  if [[ ! -f "$sourceFile" ]]; then
    print -r -- "Missing template: $sourceFile. Use the generated package with its unsigned folder."
    read -r "?Press Return to close. "
    exit 1
  fi
done

print -r -- "Apple will validate the generic templates. A Mac signed into iCloud is required."
for name in "${names[@]}"; do
  if ! /usr/bin/shortcuts sign --mode anyone --input "$packageDir/unsigned/$name.shortcut" --output "$packageDir/$name.shortcut"; then
    print -r -- "Signing failed. Check this Mac's iCloud sign-in, then double-click this helper again. Do not send unsigned or partially generated files to the iPhone."
    read -r "?Press Return to close. "
    exit 1
  fi
done

print -r -- "All five files are signed. AirDrop the top-level .shortcut files to the iPhone, not the unsigned folder."
/usr/bin/open "$packageDir"
read -r "?Press Return to close. "
# AI: end
